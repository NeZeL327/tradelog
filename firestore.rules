rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Subskrypcje: tylko wlasny dokument uzytkownika
    match /subscriptions/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Users: only own profile doc
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/accounts/{accountId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['mtIntegration']);
      allow update: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['mtIntegration']);
    }

    match /users/{userId}/{collectionName}/{docId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && collectionName != 'accounts';
    }

    // Domyslnie blokuj wszystko inne
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
