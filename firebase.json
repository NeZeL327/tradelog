{
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "site": "trade-log-b814b",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "/stripe-sidebar-wallpaper-portrait.jpg",
        "headers": [
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"stripe-sidebar-wallpaper-portrait.jpg\""
          },
          { "key": "Cache-Control", "value": "public, max-age=86400" }
        ]
      },
      {
        "source": "/stripe-sidebar-wallpaper-portrait.png",
        "headers": [
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"stripe-sidebar-wallpaper-portrait.png\""
          },
          { "key": "Cache-Control", "value": "public, max-age=86400" }
        ]
      }
    ],
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  },
  "emulators": {
    "firestore": {
      "port": 8082
    },
    "hosting": {
      "port": 5003
    },
    "functions": {
      "port": 5004
    },
    "storage": {
      "port": 9198
    },
    "ui": {
      "enabled": false
    }
  }
}
